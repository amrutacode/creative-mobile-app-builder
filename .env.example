# App Setup
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database (Drizzle ORM) - CloudHike.dev
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/your_database
DIRECT_URL=postgresql://postgres:your_password@localhost:5432/your_database

# Auth API - CloudHike.dev
AUTH_URL=https://cloudhike.dev/api/auth-service/your-project
AUTH_PUBLISHABLE_KEY=pk_your_publishable_key
AUTH_SECRET_KEY=sk_your_secret_key

# Exposed to the browser (publishable key only, never the secret key)
NEXT_PUBLIC_AUTH_URL=https://cloudhike.dev/api/auth-service/your-project
NEXT_PUBLIC_AUTH_PUBLISHABLE_KEY=pk_your_publishable_key

# AI Agent - OpenAI directly (used ONLY by lib/server/ai-agent; CloudHike services above are unaffected)
AI_API_KEY=
# Optional: override the agent model (default: gpt-5.4)
# AI_AGENT_MODEL=gpt-5.4
